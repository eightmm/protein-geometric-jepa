{
  "model": {
    "scalar": 16,
    "vector": 4,
    "tensor": 2,
    "sequence_width": 32,
    "sequence_layers": 1,
    "heads": 4,
    "atom_layers": 1,
    "backbone_layers": 1,
    "aa_layers": 1,
    "internal_layers": 1,
